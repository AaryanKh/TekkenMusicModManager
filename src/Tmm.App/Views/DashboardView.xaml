<UserControl x:Class="Tmm.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Tmm.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- A tile. The song's art sits on a slightly tilted plane; the Tekken game's card is tucked
             behind it. Hovering or selecting lifts the art toward the viewer and slides the card out,
             the way an app tile responds, and letting go eases it back. One trigger drives both from
             "hovered OR selected", so leaving the mouse over a selected tile does not collapse it. -->
        <DataTemplate x:Key="ModTile">
            <Grid Width="176" Margin="6" Cursor="Hand" Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick"
                                  Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  CommandParameter="{Binding}"/>
                </Grid.InputBindings>
                <Grid.RowDefinitions>
                    <RowDefinition Height="176"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,12,0,0">
                    <!-- Tekken card: starts hidden directly behind the art, animates out and up. -->
                    <Image x:Name="BackCard" Source="{Binding GameCover}" Width="148" Height="148" Stretch="UniformToFill"
                           HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Opacity="0">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="BackRotate" Angle="0"/>
                                <TranslateTransform x:Name="BackMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Song art on its plane -->
                    <Border x:Name="FrontCard" Width="148" Height="148" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="6"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource Panel2Brush}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="FrontScale" ScaleX="1" ScaleY="1"/>
                                <SkewTransform x:Name="FrontSkew" AngleX="0" AngleY="0"/>
                                <TranslateTransform x:Name="FrontMove" X="0" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="FrontShadow" BlurRadius="14" ShadowDepth="3" Opacity="0.55"/>
                        </Border.Effect>
                        <Border CornerRadius="6" ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0.55"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding CoverForState}" Stretch="UniformToFill"/>
                        </Border>
                    </Border>

                    <!-- Enabled dot, riding on the front card's transform so it lifts with it -->
                    <Ellipse Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="128,8,0,0"
                             StrokeThickness="2" Stroke="{StaticResource BgBrush}" RenderTransformOrigin="0.5,0.5"
                             RenderTransform="{Binding RenderTransform, ElementName=FrontCard}">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource GoodBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40"
                           TextTrimming="CharacterEllipsis" Margin="12,8,4,0" ToolTip="{Binding Name}"/>
                <TextBlock Grid.Row="2" Text="{Binding SlotTitle}" Style="{StaticResource Muted}" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="12,2,4,4" ToolTip="{Binding SlotTitle}"/>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource AnyTrue}">
                            <Binding Path="IsMouseOver" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                            <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <!-- front: lift, lean, grow -->
                                <DoubleAnimation Storyboard.TargetName="FrontScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontSkew" Storyboard.TargetProperty="AngleY" To="-3" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontSkew" Storyboard.TargetProperty="AngleX" To="1.5" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontMove" Storyboard.TargetProperty="Y" To="-5" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontShadow" Storyboard.TargetProperty="ShadowDepth" To="9" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="FrontShadow" Storyboard.TargetProperty="BlurRadius" To="22" Duration="0:0:0.18"/>
                                <!-- back: slide out from behind, turn, fade in -->
                                <DoubleAnimation Storyboard.TargetName="BackMove" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="BackMove" Storyboard.TargetProperty="Y" To="-18" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="BackRotate" Storyboard.TargetProperty="Angle" To="-9" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="BackCard" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="FrontScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontSkew" Storyboard.TargetProperty="AngleY" To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontSkew" Storyboard.TargetProperty="AngleX" To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="FrontShadow" Storyboard.TargetProperty="ShadowDepth" To="3" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetName="FrontShadow" Storyboard.TargetProperty="BlurRadius" To="14" Duration="0:0:0.22"/>
                                <DoubleAnimation Storyboard.TargetName="BackMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="BackMove" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="BackRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="BackCard" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TileContainer" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding CountLine}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource BadBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameOk}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GoodBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding GameStatus}" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding SetupOk, Converter={StaticResource Vis}, ConverterParameter=invert}">
                    <TextBlock Text="{Binding SetupStatus}" Style="{StaticResource Warning}" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="Open Settings" Style="{StaticResource SmallButton}" Command="{Binding GoToSettingsCommand}" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Content="+  New mod" Style="{StaticResource AccentButton}" Command="{Binding NewModCommand}" Margin="0,0,6,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0"/>
                <Button Content="Rebuild all stale" Command="{Binding RebuildStaleCommand}" Margin="0,0,6,0"/>
                <Button Content="Scan ~mods for other paks" Command="{Binding ScanCommand}" Margin="0,0,6,0"/>
                <Button Content="Open ~mods" Command="{Binding OpenModsFolderCommand}"/>
            </WrapPanel>
        </Grid>

        <!-- Busy -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" Width="140" IsIndeterminate="True" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding BusyText}"/>
            </DockPanel>
        </Border>

        <!-- Bottom row: view toggle on the right, tile-only extras on the left when tiles are showing -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False"
                   Visibility="{Binding HasMods, Converter={StaticResource Vis}}">
            <Button DockPanel.Dock="Right" Content="{Binding ViewToggleLabel}" Command="{Binding ToggleViewCommand}"
                    ToolTip="Switch between the table and album-art tiles. Both offer the same actions."/>
        </DockPanel>

        <!-- Third-party paks -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12,8" Margin="0,10,0,0" Visibility="{Binding ThirdPartyNote, Converter={StaticResource Vis}}">
            <StackPanel>
                <TextBlock Text="{Binding ThirdPartyNote}" Style="{StaticResource Muted}"/>
                <ItemsControl ItemsSource="{Binding ThirdParty}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12">
                                <Run Text="{Binding File, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" WEM(s): "/><Run Text="{Binding Ids, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Selected tile: details and every action the table row has, plus the art actions that only
             make sense here. -->
        <Border DockPanel.Dock="Bottom" Padding="14,10" Margin="0,10,0,0">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ShowTiles}" Value="True"/>
                                <Condition Binding="{Binding HasSelection}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid x:Name="PanelGrid" DataContext="{Binding SelectedRow}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- The selected tile's art, repeated here so the panel reads as belonging to it. -->
                <Border Grid.Row="1" Grid.Column="0" Width="86" Height="86" CornerRadius="5" ClipToBounds="True" VerticalAlignment="Top"
                        Margin="0,2,14,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                        Background="{StaticResource Panel2Brush}">
                    <Image Source="{Binding CoverForState}" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Style="{StaticResource Badge}" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="{Binding State, Converter={StaticResource StateBrush}}"/>
                                <TextBlock Text="{Binding StateLabel}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Style="{StaticResource Muted}" Margin="0,4,0,0">
                        <Run Text="Replaces "/><Run Text="{Binding SlotTitle, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  song: "/><Run Text="{Binding SongFile, Mode=OneWay}"/><Run Text="  ·  built "/><Run Text="{Binding LastBuilt, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding PlanSummary}" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding LoudnessSummary}" FontSize="12" Style="{StaticResource Muted}"
                               Visibility="{Binding LoudnessSummary, Converter={StaticResource Vis}}"/>
                    <TextBlock FontSize="12" Style="{StaticResource Muted}">
                        <Run Text="Overrides WEM IDs "/><Run Text="{Binding WemIds, Mode=OneWay}"/><Run Text="  ·  source: "/><Run Text="{Binding SongPath, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Source song file is missing — Rebuild and Edit need it." Style="{StaticResource Warning}" FontSize="12"
                               Visibility="{Binding SongMissing, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="No album art for this tile — showing a placeholder. Use Find art to look one up." Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"
                               Visibility="{Binding HasOwnArt, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                </StackPanel>
                <!-- Track player. Sits between the mod's details and its actions; once the panel is
                     narrower than 560 it moves to its own full-width row above them. -->
                <!-- Placement is set in code-behind from PanelGrid's width: inline while there is
                     room, its own full-width row under 560. -->
                <Border x:Name="PlayerBox" CornerRadius="6" Padding="10,8" Background="{StaticResource Panel2Brush}"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Top"
                        Grid.Row="1" Grid.Column="2" Margin="28,0,28,0" MinWidth="200" MaxWidth="330">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource PlayGlyphButton}" Margin="0,0,10,0"
                                    Content="{Binding DataContext.PlayPauseGlyph, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Command="{Binding DataContext.PlayPauseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ToolTip="Play the song this mod was built from, starting at the loop."/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                       FontSize="11" Style="{StaticResource Muted}"
                                       Text="{Binding DataContext.PlayerTimeText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <Slider Style="{StaticResource ScrubSlider}" Minimum="0"
                                    Maximum="{Binding DataContext.PlayerDurationSec, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Value="{Binding DataContext.PlayerPositionSec, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    IsEnabled="{Binding DataContext.IsPlayerActive, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="40,4,0,0" TextTrimming="CharacterEllipsis"
                                   Text="{Binding DataContext.PlayerTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   ToolTip="{Binding DataContext.PlayerTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Enable" Style="{StaticResource SmallButton}"
                                Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsEnabled, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                        <Button Content="Disable" Style="{StaticResource SmallButton}"
                                Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Visibility="{Binding IsEnabled, Converter={StaticResource Vis}}"/>
                        <Button Content="Rebuild" Style="{StaticResource SmallButton}"
                                Command="{Binding DataContext.RebuildCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <Button Content="Edit" Style="{StaticResource SmallButton}"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <Button Content="Delete" Style="{StaticResource SmallButton}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="Find art online…" Style="{StaticResource SmallButton}"
                                Command="{Binding DataContext.FindArtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="Looks the album up from the song's tags (and offers the picture inside the file, if any). You choose; nothing is applied on its own."/>
                        <Button Content="Remove art" Style="{StaticResource SmallButton}"
                                Command="{Binding DataContext.RemoveArtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                ToolTip="Back to the placeholder. The picture inside the file is not pulled back in until you ask for it."/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: empty state, table, or tiles -->
        <Grid x:Name="Body" Background="Transparent">
            <Border Style="{StaticResource Card}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32"
                    Visibility="{Binding HasMods, Converter={StaticResource Vis}, ConverterParameter=invert}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="No mods yet" Style="{StaticResource H2}" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,14" TextAlignment="Center" MaxWidth="420"
                               Text="Drop a song anywhere in this window, pick the jukebox slot it fits best, preview the loop, build. Enabling copies the pak into the game's ~mods folder; disabling removes it, the mod stays here."/>
                    <Button Content="Create your first mod" Style="{StaticResource AccentButton}" Command="{Binding NewModCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Table -->
            <DataGrid ItemsSource="{Binding Rows}" RowDetailsVisibilityMode="VisibleWhenSelected">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasMods}" Value="True"/>
                                    <Condition Binding="{Binding ShowTable}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="State" Width="120" SortMemberPath="State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Badge}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center" Background="{Binding State, Converter={StaticResource StateBrush}}"/>
                                        <TextBlock Text="{Binding StateLabel}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Mod" Binding="{Binding Name}" Width="180"/>
                    <DataGridTextColumn Header="Replaces" Binding="{Binding SlotTitle}" Width="*"/>
                    <DataGridTextColumn Header="Song" Binding="{Binding SongFile}" Width="180"/>
                    <DataGridTextColumn Header="Last built" Binding="{Binding LastBuilt}" Width="130"/>
                    <DataGridTemplateColumn Header="Actions" Width="330">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Enable" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.EnableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                            Visibility="{Binding IsEnabled, Converter={StaticResource Vis}, ConverterParameter=invert}"/>
                                    <Button Content="Disable" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                            Visibility="{Binding IsEnabled, Converter={StaticResource Vis}}"/>
                                    <Button Content="Rebuild" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.RebuildCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    <Button Content="Edit" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    <Button Content="Delete" Style="{StaticResource SmallButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgBrush}" Padding="12,8">
                            <StackPanel>
                                <TextBlock Text="{Binding PlanSummary}" FontSize="12"/>
                                <TextBlock Text="{Binding LoudnessSummary}" FontSize="12" Style="{StaticResource Muted}"
                                           Visibility="{Binding LoudnessSummary, Converter={StaticResource Vis}}"/>
                                <TextBlock FontSize="12" Style="{StaticResource Muted}">
                                    <Run Text="Overrides WEM IDs "/><Run Text="{Binding WemIds, Mode=OneWay}"/><Run Text="  ·  source: "/><Run Text="{Binding SongPath, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="Source song file is missing — Rebuild and Edit need it." Style="{StaticResource Warning}" FontSize="12"
                                           Visibility="{Binding SongMissing, Converter={StaticResource Vis}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <!-- Tiles -->
            <ListBox x:Name="Tiles" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                     ItemTemplate="{StaticResource ModTile}" ItemContainerStyle="{StaticResource TileContainer}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasMods}" Value="True"/>
                                    <Condition Binding="{Binding ShowTiles}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
