<Window x:Class="Tmm.App.Views.ArtPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose album art" Width="760" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" x:Name="Heading" Style="{StaticResource H2}" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"
                   Text="Pick the picture to use for this tile. The first entry is the art inside the song file itself, when it has one; the rest were found online from the song's tags."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
            <Button x:Name="UseButton" Content="Use this picture" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="140" Click="OnUse"/>
        </StackPanel>
        <ListBox x:Name="List" Background="Transparent" BorderThickness="0" SelectionChanged="OnSelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnDoubleClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="4"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="{StaticResource PanelBrush}" Padding="8">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150">
                        <Border Width="134" Height="134" CornerRadius="4" Background="{StaticResource Panel2Brush}" ClipToBounds="True">
                            <!-- A string bound to Image.Source becomes a BitmapImage; http and file URIs both work. -->
                            <Image Source="{Binding ThumbUrl}" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
