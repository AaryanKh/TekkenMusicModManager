<UserControl x:Class="Tmm.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Tmm.App.ViewModels"
             xmlns:ctl="clr-namespace:Tmm.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}">
                        <Run Text="{Binding SongTitle, Mode=OneWay}" FontWeight="Bold"/><Run Text="  →  "/><Run Text="{Binding SlotTitle, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding SlotSummary}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="‹  Back to ranking" Command="{Binding BackCommand}" VerticalAlignment="Top"/>
            </Grid>

            <!-- Waveform -->
            <Border Style="{StaticResource Card}" Padding="8">
                <StackPanel>
                    <ctl:WaveformControl Height="160"
                                         Peaks="{Binding Peaks}" DurationSec="{Binding DurationSec}" Downbeats="{Binding Downbeats}"
                                         LoopStartSec="{Binding LoopStartSec, Mode=TwoWay}" LoopEndSec="{Binding LoopEndSec}"
                                         IntroStartSec="{Binding IntroStartSec, Mode=TwoWay}" IntroEndSec="{Binding IntroEndSec}"
                                         ShowIntro="{Binding SlotHasIntro}" IntroDraggable="{Binding IntroDraggable}"/>
                    <Grid Margin="4,6,4,0">
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Left"
                                   Text="{Binding WaveformHint}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" Text="{Binding DurationSec, Converter={StaticResource Seconds}}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Controls + score -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Loop start (seconds)" Style="{StaticResource Label}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Snap to bar" Style="{StaticResource SmallButton}" Command="{Binding SnapCommand}" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding LoopStartSec, StringFormat={}{0:0.000}, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Loop length (bars)" Style="{StaticResource Label}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Content="−" Style="{StaticResource SmallButton}" Command="{Binding BarsDownCommand}" Width="30"/>
                                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource SmallButton}" Command="{Binding BarsUpCommand}" Width="30" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding LoopBars, UpdateSourceTrigger=LostFocus}" TextAlignment="Center" Margin="6,0,0,0"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0">
                                <Run Text="{Binding NaturalSec, Mode=OneWay, StringFormat={}{0:0.00} s natural}"/><Run Text="  ·  stretch "/><Run Text="{Binding StretchPercent, Mode=OneWay, StringFormat={}{0:0.00}%}"/><Run Text="  ·  rho "/><Run Text="{Binding Rho, Mode=OneWay, StringFormat={}{0:0.0000}}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Intro" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding IntroOptions}" SelectedItem="{Binding IntroStrategy}" IsEnabled="{Binding SlotHasIntro}"/>
                            <CheckBox Content="Detach intro from the loop" IsChecked="{Binding DetachIntro}" IsEnabled="{Binding SlotHasIntro}" Margin="0,8,0,0"/>
                            <DockPanel Margin="0,6,0,0" IsEnabled="{Binding DetachIntro}">
                                <TextBlock DockPanel.Dock="Left" Text="from " Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Song start" Style="{StaticResource SmallButton}" Command="{Binding IntroToSongStartCommand}" Margin="6,0,0,0"/>
                                <TextBox Text="{Binding IntroSourceStartSec, StringFormat={}{0:0.000}, UpdateSourceTrigger=LostFocus}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                       Text="Real = the material right before the loop start. Detach = take the intro from anywhere in the song, so you can keep the real opening and still loop a later section. Fade in = whatever exists, padded with silence. Silence = nothing."/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Seam crossfade (ms)" Style="{StaticResource Label}"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CrossfadeMs, StringFormat={}{0:0}}" Width="30" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <Slider Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding CrossfadeMs}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" Text="0 keeps a butt joint. 20 ms hides most clicks; 100+ smears transients."/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Loudness" Style="{StaticResource Label}"/>
                            <DockPanel>
                                <CheckBox Content="Match to" IsChecked="{Binding UseLoudness}" VerticalAlignment="Center"/>
                                <TextBox Width="60" Text="{Binding TargetLufs, StringFormat={}{0:0.0}, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UseLoudness}" Margin="6,0,0,0"/>
                                <TextBlock Text=" LUFS" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Volume trim" Style="{StaticResource Label}"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GainDbText}" Width="56" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <Slider Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GainDb}"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                       Text="Push a quiet mod up to sit level with the rest. A peak limiter catches whatever would clip, so +6 dB is loud, not distorted."/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="▶  Preview intro" Command="{Binding PreviewIntroCommand}" Margin="0,0,6,0"/>
                                <Button Content="▶  Preview loop ×3" Command="{Binding PreviewCommand}"/>
                                <Button Content="▶  Preview full track" Command="{Binding PreviewTrackCommand}" Margin="6,0,0,0"/>
                                <Button Content="■  Stop" Command="{Binding StopCommand}" Margin="6,0,0,0" IsEnabled="{Binding IsPlaying}"/>
                                <Button Content="Reset to recommendation" Command="{Binding ResetCommand}" Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PreviewInfo}" Style="{StaticResource Muted}" Margin="0,6,0,0" Visibility="{Binding PreviewInfo, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding PreviewAdvice}" Style="{StaticResource Warning}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding PreviewAdvice, Converter={StaticResource Vis}}"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0">
                                <Run Text="Time-stretch: "/><Run Text="{Binding StretcherName, Mode=OneWay}"/><Run Text=". Set a rubberband path in Settings for pitch-preserving stretch."/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Score card -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Compatibility for this plan" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding ScoreHeadline, StringFormat={}{0:0}%}" FontSize="40" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="{Binding ScoreHeadline, Converter={StaticResource ScoreBrush}}"/>
                        <TextBlock Text="{Binding ScoreLine}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>

                        <TextBlock Text="Loop fit (stretch needed)" Style="{StaticResource Label}"/>
                        <ProgressBar Style="{StaticResource ScoreBar}" Value="{Binding ScoreLoopFit, Mode=OneWay}" Margin="0,0,0,8"/>
                        <TextBlock Text="Seam quality (vs. random cuts in this song)" Style="{StaticResource Label}"/>
                        <ProgressBar Style="{StaticResource ScoreBar}" Value="{Binding ScoreSeam, Mode=OneWay}" Margin="0,0,0,8"/>
                        <TextBlock Text="Intro fit (real material available)" Style="{StaticResource Label}"/>
                        <ProgressBar Style="{StaticResource ScoreBar}" Value="{Binding ScoreIntro, Mode=OneWay}" Margin="0,0,0,8"/>
                        <TextBlock Text="Coverage (share of the song used)" Style="{StaticResource Label}"/>
                        <ProgressBar Style="{StaticResource ScoreBar}" Value="{Binding ScoreCoverage, Mode=OneWay}" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding Validation}" Style="{StaticResource Warning}" Visibility="{Binding Validation, Converter={StaticResource Vis}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Assembled in-game track -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="8"
                    Visibility="{Binding HasTrackPreview, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="4,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Skip to the seam" Style="{StaticResource SmallButton}"
                                Command="{Binding SkipToSeamCommand}"
                                ToolTip="Jump to a few seconds before the loop wraps, instead of waiting for it."/>
                        <TextBlock Text="What is playing" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ctl:TrackStripControl Height="100"
                                           Peaks="{Binding TrackPeaks}" DurationSec="{Binding TrackDurationSec}"
                                           Boundaries="{Binding TrackBoundaries}" IntroSec="{Binding IntroLengthSec}"
                                           PlayheadSec="{Binding PlayheadSec}" SeekCommand="{Binding SeekCommand}"/>
                    <TextBlock Text="{Binding TrackSummary}" Style="{StaticResource Muted}" FontSize="11" Margin="4,6,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="4,2,0,0"
                               Text="Amber is the intro WEM, played once. Every dashed line after it is the loop wrapping back on itself, which is the join you are listening for. Click anywhere on the strip to jump there."/>
                </StackPanel>
            </Border>

            <!-- Build -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Mod name" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                                 IsEnabled="{Binding IsExisting, Converter={StaticResource InverseBool}}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                   Text="Becomes &lt;name&gt;_P.pak. Building renders both WEMs sample-exact, packs them, and stores the mod; enabling is a separate step on the dashboard so conflicts are checked in one place."/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                        <Button Content="Save plan only" Command="{Binding SavePlanCommand}" Margin="0,0,8,0" Visibility="{Binding IsExisting, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding BuildCommand}" MinWidth="150">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Build mod"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExisting}" Value="True">
                                                    <Setter Property="Text" Value="Rebuild mod"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Text" Value="Working…"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
